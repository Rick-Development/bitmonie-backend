{
  "openapi": "3.1.0",
  "info": {
    "title": "Bitmonie / Cryptomart API Reference",
    "version": "1.0.0",
    "description": "Comprehensive internal REST API documentation for the Bitmonie / Cryptomart mobile application and frontend developers."
  },
  "servers": [
    {
      "url": "https://api.bitmonie.com",
      "description": "Production Server"
    },
    {
      "url": "https://sandbox.bitmonie.com",
      "description": "Sandbox Server"
    },
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter the Bearer token returned from login/register endpoints."
      }
    },
    "schemas": {
      "StandardSuccess": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string",
            "example": "Operation completed successfully."
          },
          "data": {
            "type": "object"
          }
        }
      },
      "StandardError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Something went wrong! Please try again."
          },
          "data": {
            "type": "null"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "The given data was invalid."
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/user/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register New User Account",
        "description": "Creates a new user account on Bitmonie. Sends Account Authorization email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "firstname",
                  "lastname",
                  "email",
                  "password",
                  "password_confirmation",
                  "mobile",
                  "country"
                ],
                "properties": {
                  "firstname": {
                    "type": "string",
                    "example": "John"
                  },
                  "lastname": {
                    "type": "string",
                    "example": "Doe"
                  },
                  "username": {
                    "type": "string",
                    "example": "johndoe",
                    "description": "Optional unique username"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "john@example.com"
                  },
                  "mobile": {
                    "type": "string",
                    "example": "+2348012345678"
                  },
                  "country": {
                    "type": "string",
                    "example": "Nigeria"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "Secret@1234"
                  },
                  "password_confirmation": {
                    "type": "string",
                    "format": "password",
                    "example": "Secret@1234"
                  },
                  "referral_code": {
                    "type": "string",
                    "example": "BM-REF123",
                    "description": "Optional referral code"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registration successful with authorization token"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/v1/user/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "User Login (Email / Username & Password)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "credentials",
                  "password"
                ],
                "properties": {
                  "credentials": {
                    "type": "string",
                    "example": "john@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "Secret@1234"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated successfully, returns Bearer token and user profile"
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/user/login-with-pin": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "User Quick Login with 4-Digit PIN",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "pin"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "john@example.com"
                  },
                  "pin": {
                    "type": "string",
                    "example": "1234"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated successfully"
          }
        }
      }
    },
    "/api/v1/user/authorize/mail/verify/code": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Verify Email Authorization OTP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "code"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "example": "authorization-token-from-register"
                  },
                  "code": {
                    "type": "integer",
                    "example": 123456
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verified successfully"
          }
        }
      }
    },
    "/api/v1/user/authorize/mail/resend/code": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Resend Email Authorization Code",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "authorization-token-from-register"
          }
        ],
        "responses": {
          "200": {
            "description": "Verification code resent"
          }
        }
      }
    },
    "/api/v1/user/crypto-cards/charges": {
      "get": {
        "tags": [
          "Crypto Cards"
        ],
        "security": [
          {
            "bearerAuth": []
          }
