        "summary": "Get Configured Crypto Card Fees (Virtual & Physical)",
        "description": "Returns categorized fee structures for virtual card issuance/funding/maintenance and physical card order/funding/maintenance.",
        "responses": {
          "200": {
            "description": "Crypto card charges retrieved successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Crypto card charges retrieved successfully.",
                  "data": {
                    "currency": "USDT",
                    "virtual_card": {
                      "card_issuance_fee": "3.00",
                      "card_funding_fee": "0.50",
                      "monthly_card_maintenance_fee": "1.00"
                    },
                    "physical_card": {
                      "physical_card_fee": "10.00",
                      "card_funding_fee": "1.00",
                      "monthly_card_maintenance_fee": "2.00"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user/crypto-cards/holders": {
      "get": {
        "tags": [
          "Crypto Cards"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get Card Holder Status & Verified Info",
        "responses": {
          "200": {
            "description": "Card holder information returned"
          }
        }
      }
    },
    "/api/v1/user/crypto-cards/create-holder": {
      "post": {
        "tags": [
          "Crypto Cards"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create Card Holder (BVN Optional for Tier 1+ Verified Users)",
        "description": "Creates a card holder profile. For users who have verified KYC (Tier 1+), BVN is optional and automatically retrieved and forwarded directly to the provider.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "John Doe"
                  },
                  "email": {
                    "type": "string",
                    "example": "john@example.com"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "example": "+2348012345678"
                  },
                  "individual": {
                    "type": "object",
                    "properties": {
                      "identity": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "example": "BVN"
                          },
                          "number": {
                            "type": "string",
                            "example": "22233344455",
                            "description": "Optional if user is Tier 1+ verified"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Card holder created successfully"
          }
        }
      }
    },
    "/api/v1/user/crypto-cards/create": {
      "post": {
        "tags": [
          "Crypto Cards"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create / Issue Crypto Card (Virtual or Physical)",
        "description": "Creates a crypto card and debits the appropriate issuance fee from the user fiat NGN balance.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "provider",
                  "type",
                  "currency"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "sudo"
                    ],
                    "example": "sudo"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "virtual",
                      "physical"
                    ],
                    "example": "virtual"
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "USDT",
                      "usdt"
                    ],
                    "example": "USDT"
                  },
                  "brand": {
                    "type": "string",
                    "example": "Mastercard"
                  },
                  "cardHolderId": {
                    "type": "integer",
                    "example": 123
                  },
                  "number": {
                    "type": "string",
                    "description": "Required only if type is physical"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Card created successfully"
          }
        }
      }
    },
